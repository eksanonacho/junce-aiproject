# 君册财税 AI 初诊 — 生产环境变量模板
# 复制为 .env 并填入真实值，不要提交 .env 到 git

# PostgreSQL
POSTGRES_USER=a1234
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=junce_ai_diagnosis

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=production

# AI (keep disabled)
AI_POLISH_ENABLED=false

# CORS — 逗号分隔允许的前端域名
CORS_ORIGINS=https://your-domain.com

# Admin seed credentials (仅首次 seed 使用)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
