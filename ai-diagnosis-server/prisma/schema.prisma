// Prisma Schema — 君册财税 AI 初诊网站
// Phase 0：16 个模型，MVP 核心数据表

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  RANGE
  YES_NO
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  DIAGNOSING
  COMPLETED
}

enum SubmissionSource {
  WEB
  MINIPROGRAM
  STAFF
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum ReviewStatus {
  NEED_REVIEW
  AUTO_RELEASED
  REVIEWED
  REJECTED
}

enum ReviewAction {
  APPROVE
  REJECT
  MODIFY
}

enum RecommendPriority {
  STRONG
  SUGGEST
  INFO
}

enum AdminRole {
  ACCOUNTANT
  MANAGER
  ADMIN
}

// ============================================================
// Models
// ============================================================

model Questionnaire {
  id          Int           @id @default(autoincrement())
  version     String
  title       String
  description String?
  isActive    Boolean       @default(true)
  questions   Question[]
  submissions Submission[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Question {
  id              Int            @id @default(autoincrement())
  publicId        String?        @unique
  questionnaireId Int
  questionnaire   Questionnaire  @relation(fields: [questionnaireId], references: [id])
  groupLabel      String
  groupOrder      Int
  orderInGroup    Int
  questionText    String
  questionType    QuestionType
  options         Json
  isRequired      Boolean        @default(false)
  riskDimension   String?
  answers         Answer[]
  diagnosisRules  DiagnosisRule[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Submission {
  id                    Int              @id @default(autoincrement())
  publicId              String           @unique @default(cuid())
  questionnaireId       Int
  questionnaire         Questionnaire    @relation(fields: [questionnaireId], references: [id])
  status                SubmissionStatus @default(PENDING)
  phone                 String?
  phoneVerified         Boolean          @default(false)
  source                SubmissionSource @default(WEB)
  miniProgramCustomerId Int?
  submittedAt           DateTime?
  answers               Answer[]
  diagnosisResult       DiagnosisResult?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model Answer {
  id           Int        @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id])
  questionId   Int
  question     Question   @relation(fields: [questionId], references: [id])
  answerValue  Json
  createdAt    DateTime   @default(now())
}

model DiagnosisRule {
  id                 Int       @id @default(autoincrement())
  ruleCode           String    @unique
  dimension          String
  questionId         Int?
  question           Question? @relation(fields: [questionId], references: [id])
  triggerCondition   Json
  compositeCondition Json?
  riskLevel          RiskLevel
  riskTitle          String
  riskDescription    String
  suggestion         String
  needReview         Boolean   @default(false)
  recommendServices  Json?
  isActive           Boolean   @default(true)
  findings           RiskFinding[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model RiskScenario {
  id                Int       @id @default(autoincrement())
  scenarioName      String
  scenarioCode      String    @unique
  description       String
  riskLevel         RiskLevel
  triggerRules      Json
  safeExplanation   String
  forbiddenPhrases  String[]
  suggestion        String
  recommendServices Json?
  needManualReview  Boolean        @default(false)
  isActive          Boolean        @default(true)
  findings          RiskFinding[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model DiagnosisResult {
  id               Int                    @id @default(autoincrement())
  submissionId     Int                    @unique
  submission       Submission             @relation(fields: [submissionId], references: [id])
  overallRiskLevel RiskLevel
  summary          String?
  dimensionResults Json
  needReview       Boolean                @default(true)
  findings         RiskFinding[]
  recommendations  ServiceRecommendation[]
  report           Report?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model RiskFinding {
  id                Int                @id @default(autoincrement())
  diagnosisResultId Int
  diagnosisResult   DiagnosisResult    @relation(fields: [diagnosisResultId], references: [id])
  ruleId            Int?
  rule              DiagnosisRule?     @relation(fields: [ruleId], references: [id])
  scenarioId        Int?
  scenario          RiskScenario?      @relation(fields: [scenarioId], references: [id])
  riskLevel         RiskLevel
  title             String
  description       String
  suggestion        String
  recommendServices Json?
  createdAt         DateTime           @default(now())
}

model ServiceRecommendation {
  id                Int                @id @default(autoincrement())
  diagnosisResultId Int
  diagnosisResult   DiagnosisResult    @relation(fields: [diagnosisResultId], references: [id])
  serviceType       String
  reason            String
  priority          RecommendPriority
  createdAt         DateTime           @default(now())
}

model Report {
  id                Int                  @id @default(autoincrement())
  publicId          String               @unique @default(cuid())
  diagnosisResultId Int                  @unique
  diagnosisResult   DiagnosisResult      @relation(fields: [diagnosisResultId], references: [id])
  reportNumber      String               @unique
  title             String
  riskLevel         RiskLevel
  reviewStatus      ReviewStatus         @default(NEED_REVIEW)
  customerVisible   Boolean              @default(false)
  htmlContent       String?
  disclaimerText    String
  reviewedById      Int?
  reviewedAt        DateTime?
  reviewRecords     ReviewRecord[]
  accessTokens      ReportAccessToken[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model ReportAccessToken {
  id         Int       @id @default(autoincrement())
  reportId   Int
  report     Report    @relation(fields: [reportId], references: [id])
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model ReviewRecord {
  id         Int          @id @default(autoincrement())
  reportId   Int
  report     Report       @relation(fields: [reportId], references: [id])
  reviewerId Int
  reviewer   AdminUser    @relation(fields: [reviewerId], references: [id])
  action     ReviewAction
  changes    Json?
  comment    String?
  createdAt  DateTime     @default(now())
}

model ForbiddenPhrase {
  id              Int     @id @default(autoincrement())
  phrase          String
  safeAlternative String
  category        String
  isActive        Boolean @default(true)
}

model Disclaimer {
  id       Int     @id @default(autoincrement())
  version  String
  content  String
  isActive Boolean @default(true)
}

model SmsVerificationCode {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String
  scene      String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
}

model AdminUser {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  passwordHash  String
  realName      String
  role          AdminRole
  reviewRecords ReviewRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
